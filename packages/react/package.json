{
  "name": "kiri-react",
  "version": "0.1.0-alpha.2",
  "description": "React wrapper component for the Kiri image cropper.",
  "type": "module",
  "main": "./dist/kiri-react.cjs",
  "module": "./dist/kiri-react.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kiri-react.js",
      "require": "./dist/kiri-react.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@michaelyagi/kiri": "^0.1.0-alpha.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT"
}
