{
  "name": "kiri",
  "version": "0.1.0",
  "description": "A dependency-free TypeScript library for interactive image cropping in the browser.",
  "type": "module",
  "main": "./dist/kiri.umd.cjs",
  "module": "./dist/kiri.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kiri.js",
      "require": "./dist/kiri.umd.cjs"
    },
    "./kiri.css": "./dist/kiri.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').copyFileSync('src/kiri.css','dist/kiri.css')\"",
    "test": "vitest run"
  },
  "keywords": [
    "image",
    "crop",
    "cropper",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vitest": "^2.1.0"
  }
}
