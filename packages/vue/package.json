{
  "name": "kiri-vue",
  "version": "0.1.0-alpha.2",
  "description": "Vue wrapper component for the Kiri image cropper.",
  "type": "module",
  "main": "./dist/kiri-vue.cjs",
  "module": "./dist/kiri-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/kiri-vue.js",
      "require": "./dist/kiri-vue.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": ">=3"
  },
  "dependencies": {
    "@michaelyagi/kiri": "^0.1.0-alpha.2"
  },
  "devDependencies": {
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.2.0",
    "vitest": "^2.1.0",
    "vue": "^3.4.0"
  },
  "license": "MIT"
}
